# Analisador de Planilhas do Microsoft Planner — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com suas chaves reais:
#   cp .env.example .env
#
# O `.env` é ignorado pelo Git (contém segredos); nunca o commite.

GEMINI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Opcional: segredo da sessão Flask. Se ausente, usa um valor de desenvolvimento.
# FLASK_SECRET_KEY=
